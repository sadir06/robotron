# === VLM API — set at least ONE ===
# Option 1: OpenRouter (free tier, no GPU needed)
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-exp:free

# Option 2: NVIDIA NIM
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl

# Option 3: vLLM (local, fastest — requires GPU)
# VLLM_BASE_URL=http://localhost:8000
# VLLM_MODEL=llava-hf/llava-1.5-7b-hf

# === Camera (external USB = use index 1, 2, 3...) ===
# Run: python scripts/list_cameras.py to find your camera index
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# === Robot ===
ROBOT_ENABLED=false

# === Pipeline ===
PIPELINE_AUTO_START=true
