# NVIDIA NIM API Configuration
# Get your key from: https://build.nvidia.com/nvidia/nemotron-3-nano-30b-a3b
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model IDs
VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl
STRATEGY_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Fallback API keys (optional)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Self-hosted option (optional)
# BREV_BASE_URL=http://localhost:8000
